# ==============================================================================
# ToolBridge: Enterprise MCP Gateway — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and populate real credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.

# --- Gateway MCP Server Configuration ---
TOOLBRIDGE_ENVIRONMENT=development
TOOLBRIDGE_LOG_LEVEL=INFO
TOOLBRIDGE_GATEWAY_NAME="ToolBridge Enterprise Gateway"

# --- Downstream MCP Server Transports ---
# stdio transport is used by desktop clients (e.g. Claude Desktop, Cursor)
TOOLBRIDGE_MCP_STDIO_ENABLED=true
# SSE / Streamable HTTP transport for remote AI applications
TOOLBRIDGE_MCP_SSE_HOST=127.0.0.1
TOOLBRIDGE_MCP_SSE_PORT=8001

# --- FastAPI Management & Admin API Authentication ---
# Generate 32+ character keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOLBRIDGE_API_HOST=127.0.0.1
TOOLBRIDGE_API_PORT=8000
TOOLBRIDGE_ADMIN_KEY=""
TOOLBRIDGE_OPERATOR_KEY=""
TOOLBRIDGE_READONLY_KEY=""
TOOLBRIDGE_ALLOW_DYNAMIC_SERVERS=false
TOOLBRIDGE_STDIO_ROLE=readonly

# --- Persistence Layer (SQLite & Audit Logging) ---
TOOLBRIDGE_SQLITE_URL="sqlite+aiosqlite:///./data/toolbridge.db"

# --- Upstream 1: GitHub MCP Integration ---
# Personal Access Token with repo / read scopes
GITHUB_PERSONAL_ACCESS_TOKEN=""

# --- Upstream 2: Sandboxed Filesystem MCP Server ---
# Path to dedicated safe workspace sandbox (defaults to ./workspace_sandbox)
FILESYSTEM_SANDBOX_ROOT="./workspace_sandbox"
FILESYSTEM_MAX_READ_BYTES=5242880  # 5 MB max per read
FILESYSTEM_MAX_WRITE_BYTES=5242880  # 5 MB max per write

# --- Upstream 3: PostgreSQL MCP Integration (Controlled Read-Only) ---
# MUST be configured with read-only database user credentials
POSTGRES_READONLY_HOST=localhost
POSTGRES_READONLY_PORT=5432
POSTGRES_READONLY_DB=toolbridge_demo
POSTGRES_READONLY_USER=mcp_readonly
POSTGRES_READONLY_PASSWORD=""
POSTGRES_QUERY_TIMEOUT_SECONDS=10.0
POSTGRES_MAX_RESULT_ROWS=500

# --- Security & Policy Guardrails ---
TOOLBRIDGE_RATE_LIMIT_PER_MINUTE=60
TOOLBRIDGE_DEFAULT_TOOL_TIMEOUT_SECONDS=30.0

# --- Streamlit Admin Dashboard ---
TOOLBRIDGE_DASHBOARD_PORT=8501
